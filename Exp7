import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import fetch_20newsgroups
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import MultinomialNB, BernoulliNB
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report,
    confusion_matrix
)

categories = [
    "comp.graphics",
    "sci.space",
    "rec.sport.baseball",
    "talk.politics.misc"
]

data = fetch_20newsgroups(
    subset="all",
    categories=categories,
    remove=("headers", "footers", "quotes"),
    shuffle=True,
    random_state=42
)

X_text = data.data
y = data.target
class_names = data.target_names

print("Number of documents:", len(X_text))
print("Number of categories:", len(class_names))
print("Categories:", class_names)

X_train_text, X_test_text, y_train, y_test = train_test_split(
    X_text,
    y,
    test_size=0.2,
    random_state=42,
    stratify=y
)

vectorizer = CountVectorizer(
    stop_words="english",
    max_features=5000,
    min_df=2
)

X_train = vectorizer.fit_transform(X_train_text)
X_test = vectorizer.transform(X_test_text)

print("\nTraining data shape:", X_train.shape)
print("Testing data shape:", X_test.shape)
print("Vocabulary size:", len(vectorizer.get_feature_names()))

multinomial_model = MultinomialNB(alpha=1.0)
multinomial_model.fit(X_train, y_train)

y_pred_multinomial = multinomial_model.predict(X_test)

bernoulli_vectorizer = CountVectorizer(
    stop_words="english",
    max_features=5000,
    min_df=2,
    binary=True
)

X_train_bernoulli = bernoulli_vectorizer.fit_transform(X_train_text)
X_test_bernoulli = bernoulli_vectorizer.transform(X_test_text)

bernoulli_model = BernoulliNB(alpha=1.0)
bernoulli_model.fit(X_train_bernoulli, y_train)

y_pred_bernoulli = bernoulli_model.predict(X_test_bernoulli)

results = pd.DataFrame({
    "Model": [
        "Multinomial Naive Bayes",
        "Bernoulli Naive Bayes"
    ],
    "Accuracy": [
        accuracy_score(y_test, y_pred_multinomial),
        accuracy_score(y_test, y_pred_bernoulli)
    ],
    "Precision": [
        precision_score(y_test, y_pred_multinomial, average="weighted", zero_division=0),
        precision_score(y_test, y_pred_bernoulli, average="weighted", zero_division=0)
    ],
    "Recall": [
        recall_score(y_test, y_pred_multinomial, average="weighted", zero_division=0),
        recall_score(y_test, y_pred_bernoulli, average="weighted", zero_division=0)
    ],
    "F1-Score": [
        f1_score(y_test, y_pred_multinomial, average="weighted", zero_division=0),
        f1_score(y_test, y_pred_bernoulli, average="weighted", zero_division=0)
    ]
})

print("\n========== PERFORMANCE COMPARISON ==========")
print(results.round(4).to_string(index=False))

print("\n========== MULTINOMIAL NAIVE BAYES REPORT ==========")
print(classification_report(
    y_test,
    y_pred_multinomial,
    target_names=class_names,
    zero_division=0
))

print("\n========== BERNOULLI NAIVE BAYES REPORT ==========")
print(classification_report(
    y_test,
    y_pred_bernoulli,
    target_names=class_names,
    zero_division=0
))

plt.figure(figsize=(10, 6))

metrics = ["Accuracy", "Precision", "Recall", "F1-Score"]
x = np.arange(len(metrics))
width = 0.35

plt.bar(
    x - width / 2,
    results.iloc[0, 1:].values,
    width,
    label="Multinomial NB",
    color="royalblue"
)

plt.bar(
    x + width / 2,
    results.iloc[1, 1:].values,
    width,
    label="Bernoulli NB",
    color="darkorange"
)

plt.xticks(x, metrics)
plt.ylabel("Score")
plt.title("Multinomial NB vs Bernoulli NB")
plt.ylim(0, 1)
plt.legend()
plt.tight_layout()
plt.show()

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

cm_multinomial = confusion_matrix(y_test, y_pred_multinomial)
cm_bernoulli = confusion_matrix(y_test, y_pred_bernoulli)

sns.heatmap(
    cm_multinomial,
    annot=True,
    fmt="d",
    cmap="Blues",
    ax=axes[0],
    xticklabels=class_names,
    yticklabels=class_names
)

axes[0].set_title("Multinomial Naive Bayes")
axes[0].set_xlabel("Predicted")
axes[0].set_ylabel("Actual")

sns.heatmap(
    cm_bernoulli,
    annot=True,
    fmt="d",
    cmap="Oranges",
    ax=axes[1],
    xticklabels=class_names,
    yticklabels=class_names
)

axes[1].set_title("Bernoulli Naive Bayes")
axes[1].set_xlabel("Predicted")
axes[1].set_ylabel("Actual")

plt.tight_layout()
plt.show()

print("\n========== FINAL SUMMARY ==========")

for _, row in results.iterrows():
    print(
        "{}: Accuracy={:.4f}, Precision={:.4f}, "
        "Recall={:.4f}, F1-Score={:.4f}".format(
            row["Model"],
            row["Accuracy"],
            row["Precision"],
            row["Recall"],
            row["F1-Score"]
        )
    )

best_model = results.loc[results["F1-Score"].idxmax(), "Model"]

print("\nBest model based on weighted F1-score:", best_model)
