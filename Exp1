import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, r2_score

print("Loading California Housing dataset...")

housing = fetch_california_housing(as_frame=True)

df = housing.frame

print("\nDataset loaded successfully!")
print("\nFirst five rows:")
print(df.head())

print("\nDataset shape:", df.shape)

print("\nDataset columns:")
print(df.columns.tolist())


X = df[["AveRooms"]].values
y = df["MedHouseVal"].values

print("\nSelected feature: AveRooms")
print("Target variable: MedHouseVal")
print("Number of samples:", len(X))


valid_mask = (
    np.isfinite(X).all(axis=1) &
    np.isfinite(y)
)

X = X[valid_mask]
y = y[valid_mask]


X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))


X_mean = X_train.mean(axis=0)
X_std = X_train.std(axis=0)


X_std[X_std == 0] = 1.0

X_train_scaled = (X_train - X_mean) / X_std
X_test_scaled = (X_test - X_mean) / X_std


X_train_b = np.c_[
    np.ones((len(X_train_scaled), 1)),
    X_train_scaled
]

X_test_b = np.c_[
    np.ones((len(X_test_scaled), 1)),
    X_test_scaled
]

def gradient_descent(X, y, learning_rate=0.01, iterations=5000):
    """
    Train linear regression using batch Gradient Descent.

    X: Input matrix including intercept column
    y: Target values
    learning_rate: Step size for parameter updates
    iterations: Number of update iterations

    Returns:
        theta: Learned model parameters
        cost_history: MSE history during training
    """

    m = len(y)


    theta = np.zeros(X.shape[1])

    cost_history = []


    for i in range(iterations):

    

        predictions = X @ theta


        errors = predictions - y


        gradients = (2 / m) * (X.T @ errors)


        theta = theta - learning_rate * gradients

    

        if i % 100 == 0:
            cost = np.mean((X @ theta - y) ** 2)
            cost_history.append(cost)

    return theta, cost_history


print("\nTraining Gradient Descent model...")

theta_gd, cost_history = gradient_descent(
    X_train_b,
    y_train,
    learning_rate=0.01,
    iterations=5000
)

print("Gradient Descent training completed!")

print("\nGradient Descent parameters:")
print("Intercept (scaled feature):", theta_gd[0])
print("Slope (scaled feature):", theta_gd[1])

y_pred_gd = X_test_b @ theta_gd


print("\nTraining Normal Equation model...")

theta_ne = np.linalg.pinv(X_train_b) @ y_train

print("Normal Equation training completed!")

print("\nNormal Equation parameters:")
print("Intercept (scaled feature):", theta_ne[0])
print("Slope (scaled feature):", theta_ne[1])


y_pred_ne = X_test_b @ theta_ne


mse_gd = mean_squared_error(y_test, y_pred_gd)
r2_gd = r2_score(y_test, y_pred_gd)

mse_ne = mean_squared_error(y_test, y_pred_ne)
r2_ne = r2_score(y_test, y_pred_ne)

print("\n")
print("=" * 60)
print("MODEL PERFORMANCE COMPARISON")
print("=" * 60)

results = pd.DataFrame({
    "Model": [
        "Gradient Descent",
        "Normal Equation"
    ],
    "MSE": [
        mse_gd,
        mse_ne
    ],
    "R-squared": [
        r2_gd,
        r2_ne
    ]
})

print(results.to_string(
    index=False,
    formatters={
        "MSE": "{:.6f}".format,
        "R-squared": "{:.6f}".format
    }
))


plt.figure(figsize=(8, 5))

plt.plot(
    np.arange(len(cost_history)) * 100,
    cost_history,
    color="blue"
)

plt.title("Gradient Descent: Cost Function")
plt.xlabel("Iterations")
plt.ylabel("Mean Squared Error")
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()


x_plot = np.linspace(
    X_train.min(),
    X_train.max(),
    300
).reshape(-1, 1)


x_plot_scaled = (x_plot - X_mean) / X_std



x_plot_b = np.c_[
    np.ones((len(x_plot_scaled), 1)),
    x_plot_scaled
]



y_line_gd = x_plot_b @ theta_gd
y_line_ne = x_plot_b @ theta_ne

plt.figure(figsize=(10, 6))


plt.scatter(
    X_train,
    y_train,
    color="gray",
    alpha=0.25,
    s=10,
    label="Training data"
)


plt.scatter(
    X_test,
    y_test,
    color="orange",
    alpha=0.35,
    s=10,
    label="Testing data"
)



plt.plot(
    x_plot,
    y_line_gd,
    color="blue",
    linewidth=2,
    label="Gradient Descent"
)


plt.plot(
    x_plot,
    y_line_ne,
    color="red",
    linestyle="--",
    linewidth=2,
    label="Normal Equation"
)

plt.title(
    "California Housing: Linear Regression Using AveRooms"
)

plt.xlabel("Average Number of Rooms (AveRooms)")
plt.ylabel("Median House Value (units of $100,000)")

plt.legend()
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()


comparison_df = pd.DataFrame({
    "Actual Value": y_test[:10],
    "Gradient Descent Prediction": y_pred_gd[:10],
    "Normal Equation Prediction": y_pred_ne[:10]
})

print("\nFirst 10 actual and predicted values:")
print(comparison_df.round(4).to_string(index=False))


print("\n")
print("=" * 60)
print("FINAL INTERPRETATION")
print("=" * 60)

print("\nGradient Descent:")
print("MSE =", round(mse_gd, 6))
print("R-squared =", round(r2_gd, 6))

print("\nNormal Equation:")
print("MSE =", round(mse_ne, 6))
print("R-squared =", round(r2_ne, 6))

print("\nConclusion:")

if np.isclose(mse_gd, mse_ne, rtol=1e-4, atol=1e-8):
    print(
        "Both methods produced similar predictions and "
        "comparable test performance."
    )
else:
    print(
        "The methods produced different test errors. "
        "Check convergence and the parameter settings."
    )

print(
    "\nA lower MSE indicates smaller average squared prediction errors."
)

print(
    "An R-squared value closer to 1 indicates that the model "
    "explains more of the variation in the target values."
)

print(
    "\nNote: This experiment uses only AveRooms as a predictor. "
    "Housing prices also depend on other factors, so a one-feature "
    "linear model has limited predictive power."
)
