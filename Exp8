import numpy as np
import matplotlib.pyplot as plt
import time

from tensorflow.keras.datasets import fashion_mnist
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    ConfusionMatrixDisplay
)
from sklearn.model_selection import train_test_split

# Load Fashion MNIST dataset
(X_train, y_train), (X_test, y_test) = fashion_mnist.load_data()

class_names = [
    'T-shirt/top', 'Trouser', 'Pullover', 'Dress', 'Coat',
    'Sandal', 'Shirt', 'Sneaker', 'Bag', 'Ankle boot'
]

print("Training data shape:", X_train.shape)
print("Testing data shape:", X_test.shape)

# Display sample images
plt.figure(figsize=(10, 5))

for i in range(10):
    plt.subplot(2, 5, i + 1)
    plt.imshow(X_train[i], cmap='gray')
    plt.title(class_names[y_train[i]])
    plt.axis('off')

plt.tight_layout()
plt.show()

# Preprocess the images
X_train = X_train.reshape(X_train.shape[0], -1).astype('float32') / 255.0
X_test = X_test.reshape(X_test.shape[0], -1).astype('float32') / 255.0

# Select a subset of training data
X_train_subset, _, y_train_subset, _ = train_test_split(
    X_train,
    y_train,
    train_size=10000,
    stratify=y_train,
    random_state=42
)

# Experiment with different K values
k_values = [1, 3, 5, 7, 9]
results = []
models = {}

for k in k_values:
    print(f"\nEvaluating K = {k}")

    knn = KNeighborsClassifier(
        n_neighbors=k,
        metric='euclidean',
        n_jobs=-1
    )

    start_train = time.time()
    knn.fit(X_train_subset, y_train_subset)
    train_time = time.time() - start_train

    start_test = time.time()
    y_pred = knn.predict(X_test)
    test_time = time.time() - start_test

    accuracy = accuracy_score(y_test, y_pred)

    results.append({
        'K': k,
        'Accuracy': accuracy * 100,
        'Training Time': train_time,
        'Prediction Time': test_time
    })

    models[k] = knn

    print(f"Accuracy: {accuracy * 100:.2f}%")
    print(f"Training Time: {train_time:.2f} seconds")
    print(f"Prediction Time: {test_time:.2f} seconds")

# Display performance comparison
print("\nKNN Performance Comparison")
print(f"{'K':<10}{'Accuracy (%)':<18}{'Training Time (s)':<22}{'Prediction Time (s)':<22}")

for result in results:
    print(
        f"{result['K']:<10}"
        f"{result['Accuracy']:<18.2f}"
        f"{result['Training Time']:<22.2f}"
        f"{result['Prediction Time']:<22.2f}"
    )

# Plot accuracy for different K values
k_list = [r['K'] for r in results]
accuracy_list = [r['Accuracy'] for r in results]

plt.figure(figsize=(8, 5))
plt.plot(k_list, accuracy_list, marker='o')
plt.xlabel('K Value')
plt.ylabel('Accuracy (%)')
plt.title('KNN Accuracy for Different K Values')
plt.xticks(k_list)
plt.grid(True)
plt.tight_layout()
plt.show()

# Plot prediction time for different K values
prediction_times = [r['Prediction Time'] for r in results]

plt.figure(figsize=(8, 5))
plt.plot(k_list, prediction_times, marker='o')
plt.xlabel('K Value')
plt.ylabel('Prediction Time (seconds)')
plt.title('KNN Prediction Time for Different K Values')
plt.xticks(k_list)
plt.grid(True)
plt.tight_layout()
plt.show()

# Select the best K based on test accuracy
best_result = max(results, key=lambda r: r['Accuracy'])
best_k = best_result['K']
best_knn = models[best_k]

print(f"\nBest K: {best_k}")
print(f"Best Accuracy: {best_result['Accuracy']:.2f}%")

# Classification report
best_predictions = best_knn.predict(X_test)

print("\nClassification Report:")
print(classification_report(
    y_test,
    best_predictions,
    target_names=class_names
))

# Confusion matrix
cm = confusion_matrix(y_test, best_predictions)

disp = ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=class_names
)

fig, ax = plt.subplots(figsize=(12, 10))
disp.plot(
    ax=ax,
    cmap='Blues',
    xticks_rotation=45,
    values_format='d'
)

plt.title(f'Confusion Matrix for KNN (K={best_k})')
plt.tight_layout()
plt.show()
